# --- VLM provider (any OpenAI-compatible endpoint) ---
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.arc-bench.com/v1
# Vision-capable model, spelled exactly as your provider lists it.
# The baseline numbers in README.md use deepseek-flash on OpenRouter.
LLM_MODEL=deepseek-flash
# How much hidden reasoning a reasoning model may do: minimal, low, medium, high (empty = provider default)
LLM_REASONING_EFFORT=low
# true: describe the output format in the prompt instead of enforcing a JSON schema.
# Only needed for providers or models without structured-output support.
LLM_NO_STRUCTURED_OUTPUT=false

# Turn off browser-use telemetry
ANONYMIZED_TELEMETRY=false
